# Server
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
CLIENT_URL=http://localhost:3000
PUBLIC_SITE_URL=http://localhost:3000

# MongoDB Atlas (optional - falls back to local .data/cloud_valley.json if omitted)
MONGODB_URI=

# Authentication (generate strong random 32+ char secrets for production)
JWT_SECRET=
JWT_EXPIRES_IN=1d
COOKIE_SECRET=

# Admin Bootstrap (required on first launch to seed initial admin account)
ADMIN_NAME=Resort Administrator
ADMIN_EMAIL=admin@cloudvalleysamalbong.com
ADMIN_PASSWORD=

# Cloudinary (optional - falls back to local /uploads if omitted)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email / SMTP (optional - logs & stores in-app notification if omitted)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="CLOUD VALLEY Samalbong <reservations@cloudvalleysamalbong.com>"

# Resort Configuration
RESORT_NAME=CLOUD VALLEY
RESORT_TIMEZONE=Asia/Kolkata
RESORT_CURRENCY=INR
